# Extreme low-latency profile for hard-latency applications, e.g. trading.
# A more aggressive sibling of "latency-best": favours send/recv tail latency
# at the expense of throughput and RX/ACK batching.
#
# NOTE: requires the local prequeue-drain patches and the
# EF_TCP_LOCK_DEFER_HANDOVER_CONTENDED option.  Do not use on stock Onload.

# Spinning on, FASTSTART off, as per the standard latency profile.
onload_import latency

# Large send buffer: Onload doubles the value, so ~10 MB here.  The credit
# lets a sender keep going while another thread holds the stack lock.
# Note this overrides any per-socket SO_SNDBUF set by the application.
onload_set EF_TCP_SNDBUF 5242880

# Skip the poll at the end of the TCP send path.  Removes the send tail
# latency, at the cost of handling RX/ACK later.
onload_set EF_TCP_SEND_ADVANCE_POLL 0

# If another thread already deferred work on this TCP socket, hand our work
# over instead of blocking on the stack lock.  Needs the prequeue drains so
# that deferred data cannot be overtaken.  UDP sockets are not affected.
onload_set EF_TCP_LOCK_DEFER_HANDOVER_CONTENDED 1

# Effectively unlimited, so the blocking branch of
# ci_netif_lock_or_defer_work() is never taken.
onload_set EF_DEFER_WORK_LIMIT 65535
